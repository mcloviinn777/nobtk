rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A barbershop. Clients read it; the barber dashboard can only change its own day-to-day settings.
    // Everything else (activation, services, prices, barber code) is changed by the owner, signed in.
    match /shops/{shopId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      // The barber also sets the salon photo (a small image, under ~300 KB), his services and prices, hours,
      // barbers' names, the learned pace of cuts and whether daily revenue is kept.
      allow update: if request.auth != null
        || (request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'paused', 'chairs', 'grace', 'blockDays', 'lastSeen', 'photo',
                      'services', 'hours', 'barbers', 'pace', 'noRevenue',
                      'setupDone', 'working', 'bpause'])
            && (!('photo' in request.resource.data)
                || (request.resource.data.photo is string && request.resource.data.photo.size() < 300000))
            // the team can't be bigger than the plan the owner set (maxBarbers, changed only by the owner)
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['chairs', 'barbers'])
                || (request.resource.data.get('chairs', 1) <= resource.data.get('maxBarbers', 4)
                    && request.resource.data.get('barbers', []).size() <= resource.data.get('maxBarbers', 4))));

      // Tickets may carry the client's optional photo (small, under ~60 KB).
      // A new ticket only if the salon is active and its subscription is paid
      // (paidUntilMs, set only by the owner, plus 3 days of grace). Salons without a date are not limited.
      function shopOpen(shopId) {
        let s = get(/databases/$(database)/documents/shops/$(shopId)).data;
        return s.get('active', true) != false
          && request.time.toMillis() < s.get('paidUntilMs', 99999999999999) + 259200000;
      }
      function photoOk() {
        return !('photo' in request.resource.data)
          || (request.resource.data.photo is string && request.resource.data.photo.size() < 60000);
      }
      match /tickets/{ticketId} {
        allow read, delete: if true;
        allow create: if photoOk() && shopOpen(shopId);
        allow update: if photoOk();
      }
      match /clients/{phone} {
        allow read, create, update: if true;
        allow delete: if request.auth != null;
      }
      // Daily summaries written when the barber starts a new day.
      match /days/{day} {
        allow read, create, update: if true;
        allow delete: if request.auth != null;
      }
    }

    // Private shop profiles (contact, subscription, payments, notes): only the owner, signed in.
    match /shopProfiles/{shopId} {
      allow read, write: if request.auth != null;
    }

    // Barber sign-up form: anyone can send one, only the owner (signed in) can read and manage them.
    match /signups/{id} {
      allow create: if request.resource.data.shop is string
                    && request.resource.data.shop.size() > 0
                    && request.resource.data.shop.size() < 80
                    && request.resource.data.owner is string
                    && request.resource.data.phone is string;
      allow read, update, delete: if request.auth != null;
    }
  }
}
