rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A barbershop. Clients read it; the barber dashboard can only change its own day-to-day settings.
    // Everything else (activation, services, prices, barber code) is changed by the owner, signed in.
    match /shops/{shopId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'paused', 'chairs', 'grace', 'blockDays', 'lastSeen']);

      match /tickets/{ticketId} {
        allow read, create, update, delete: if true;
      }
      match /clients/{phone} {
        allow read, create, update: if true;
        allow delete: if request.auth != null;
      }
      // Daily summaries written when the barber starts a new day.
      match /days/{day} {
        allow read, create, update: if true;
        allow delete: if request.auth != null;
      }
    }

    // Private shop profiles (contact, subscription, payments, notes): only the owner, signed in.
    match /shopProfiles/{shopId} {
      allow read, write: if request.auth != null;
    }

    // Barber sign-up form: anyone can send one, only the owner (signed in) can read and manage them.
    match /signups/{id} {
      allow create: if request.resource.data.shop is string
                    && request.resource.data.shop.size() > 0
                    && request.resource.data.shop.size() < 80
                    && request.resource.data.owner is string
                    && request.resource.data.phone is string;
      allow read, update, delete: if request.auth != null;
    }
  }
}
