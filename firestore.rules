rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Barbershops: clients read the queue and take tickets; the barber dashboard updates it.
    // Pilot rules: the barber dashboard is protected by the shop code in the app, not by a login.
    match /shops/{shopId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'paused', 'chairs', 'grace', 'blockDays']);
      allow delete: if request.auth != null;

      match /tickets/{ticketId} {
        allow read, create, update, delete: if true;
      }
      match /clients/{phone} {
        allow read, create, update: if true;
        allow delete: if request.auth != null;
      }
    }

    // Barber sign-up form: anyone can send one, only you (signed in) can read and manage them.
    match /signups/{id} {
      allow create: if request.resource.data.shop is string
                    && request.resource.data.shop.size() > 0
                    && request.resource.data.shop.size() < 80
                    && request.resource.data.owner is string
                    && request.resource.data.phone is string;
      allow read, update, delete: if request.auth != null;
    }
  }
}
